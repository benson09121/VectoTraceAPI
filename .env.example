# VectoTrace Production Environment Configuration
# COPY THIS FILE to .env and replace the values below.
# WARNING: Never commit your actual .env file to version control.

# -----------------------------------------------------------------------------
# Django / API Backend
# -----------------------------------------------------------------------------
# DEBUG must be False in production!
DEBUG=False

# Generate a strong secret key (e.g., using `openssl rand -hex 64`)
SECRET_KEY='replace-with-a-very-long-and-secure-random-string'

# Allowed hosts for Django (e.g., localhost, your domain name)
ALLOWED_HOSTS='localhost,127.0.0.1,vectotrace.example.com'

# CORS origins for the frontend to access the API if split (not needed for unified proxy, but good to have)
CORS_ALLOWED_ORIGINS='http://localhost,https://vectotrace.example.com'

# Number of Gunicorn worker processes (Recommended: 2-4 x CPU cores)
GUNICORN_WORKERS=3

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_USER='vectotrace_user'
DB_PASS='replace-with-secure-db-password'
DB_NAME='vectotrace_db'
DB_HOST='postgressql' # Internal Docker service name
DB_PORT='5432'

# -----------------------------------------------------------------------------
# Redis (Cache & Celery Broker)
# -----------------------------------------------------------------------------
REDIS_URL='redis://redis:6379/1'

# -----------------------------------------------------------------------------
# Celery Workers
# -----------------------------------------------------------------------------
# Number of concurrent checks a single worker container can run.
CELERY_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Exposed Ports
# -----------------------------------------------------------------------------
# The HTTP port the unified reverse proxy (Nginx) binds to on the host
HTTP_PORT=80
HTTPS_PORT=443
